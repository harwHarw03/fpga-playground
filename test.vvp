#! /usr/bin/vvp
:ivl_version "11.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x7fffc5ef7bc0 .scope module, "test_gate_tb" "test_gate_tb" 2 3;
 .timescale -9 -12;
v0x7fffc5f0a7c0_0 .var "a", 0 0;
v0x7fffc5f0a890_0 .var "b", 0 0;
v0x7fffc5f0a960_0 .net "c", 0 0, L_0x7fffc5f0aa60;  1 drivers
S_0x7fffc5ef7d50 .scope module, "uut" "test_gate" 2 8, 3 1 0, S_0x7fffc5ef7bc0;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "c";
L_0x7fffc5f0aa60 .functor AND 1, v0x7fffc5f0a7c0_0, v0x7fffc5f0a890_0, C4<1>, C4<1>;
v0x7fffc5ec0ba0_0 .net "a", 0 0, v0x7fffc5f0a7c0_0;  1 drivers
v0x7fffc5f0a5e0_0 .net "b", 0 0, v0x7fffc5f0a890_0;  1 drivers
v0x7fffc5f0a6a0_0 .net "c", 0 0, L_0x7fffc5f0aa60;  alias, 1 drivers
    .scope S_0x7fffc5ef7bc0;
T_0 ;
    %vpi_call 2 15 "$dumpfile", "test.vcd" {0 0 0};
    %vpi_call 2 16 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x7fffc5ef7bc0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x7fffc5f0a7c0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x7fffc5f0a890_0, 0, 1;
    %delay 5000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x7fffc5f0a7c0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x7fffc5f0a890_0, 0, 1;
    %delay 5000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x7fffc5f0a7c0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x7fffc5f0a890_0, 0, 1;
    %delay 5000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x7fffc5f0a7c0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x7fffc5f0a890_0, 0, 1;
    %delay 10000, 0;
    %vpi_call 2 26 "$finish" {0 0 0};
    %end;
    .thread T_0;
    .scope S_0x7fffc5ef7bc0;
T_1 ;
    %vpi_call 2 30 "$monitor", "Time: %0t | a: %b, b: %b, c: %b", $time, v0x7fffc5f0a7c0_0, v0x7fffc5f0a890_0, v0x7fffc5f0a960_0 {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "test_gate_tb.v";
    "test_gate.v";
